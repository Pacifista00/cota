{
    "openapi": "3.0.0",
    "info": {
        "title": "COTA API Documentation",
        "description": "API documentation for COTA - Smart Fish Feeding System. This API provides endpoints for managing fish pond feeding schedules, monitoring sensor data, and handling user authentication.",
        "contact": {
            "name": "COTA Support",
            "email": "support@cota.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api",
            "description": "COTA API Server"
        },
        {
            "url": "/api"
        }
    ],
    "paths": {
        "/register": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "User Registration",
                "description": "Register a new user account with email, password, and profile information",
                "operationId": "0903f2e0df1a8857bee538fc055417f0",
                "requestBody": {
                    "description": "User registration data",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Registration successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RegisterResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Registration failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "User Login",
                "description": "Authenticate user with email and password, and generate access token",
                "operationId": "2dd578ff7aba2721293dac66833b27d1",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LoginResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid credentials",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthorizedResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/logout": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "User Logout",
                "description": "Invalidate the current user authentication token",
                "operationId": "68a6108af04af5e3bc1ea68a6c6f1299",
                "responses": {
                    "200": {
                        "description": "Logout successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LogoutResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "User not logged in",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthorizedResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Logout failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/feed/history": {
            "get": {
                "tags": [
                    "Feed"
                ],
                "summary": "Get Feed Execution History",
                "description": "Retrieve complete history of all feed executions including scheduled and manual feeds, ordered by execution time",
                "operationId": "e3b756213b51b15505dae46dfa305e3d",
                "responses": {
                    "200": {
                        "description": "Feed history retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FeedHistoryResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthorizedResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/sensor-data/history": {
            "get": {
                "tags": [
                    "Sensor"
                ],
                "summary": "Get Sensor Data History",
                "description": "Retrieve historical sensor data with advanced filtering, pagination, and aggregation options. Supports time-based queries, cursor pagination, and granularity control.",
                "operationId": "09b33a195a1670a45cceee374f70efbf",
                "parameters": [
                    {
                        "name": "minutes",
                        "in": "query",
                        "description": "Get data from last N minutes (mutually exclusive with from/to)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 60
                        }
                    },
                    {
                        "name": "from",
                        "in": "query",
                        "description": "Start date/time (ISO 8601 format)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date-time",
                            "example": "2024-01-01T00:00:00Z"
                        }
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "description": "End date/time (ISO 8601 format)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date-time",
                            "example": "2024-01-01T23:59:59Z"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "Maximum number of records (max: 5000)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1000,
                            "example": 100
                        }
                    },
                    {
                        "name": "order",
                        "in": "query",
                        "description": "Sort order",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "desc",
                            "enum": [
                                "asc",
                                "desc"
                            ],
                            "example": "desc"
                        }
                    },
                    {
                        "name": "cursor",
                        "in": "query",
                        "description": "Cursor for pagination (base64 encoded)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "eyJpZCI6MTIzNDV9"
                        }
                    },
                    {
                        "name": "granularity",
                        "in": "query",
                        "description": "Data granularity level",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "raw",
                            "enum": [
                                "raw",
                                "minute"
                            ],
                            "example": "raw"
                        }
                    },
                    {
                        "name": "metrics",
                        "in": "query",
                        "description": "Comma-separated list of metrics to return",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "keasaman,kekeruhan,suhu"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Sensor history data retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SensorHistoryResponse"
                                }
                            }
                        }
                    },
                    "304": {
                        "description": "Not Modified (cached data is still valid)"
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthorizedResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No history data found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "ErrorResponse": {
                "title": "Error Response",
                "description": "Standard error response structure",
                "properties": {
                    "data": {
                        "properties": {
                            "message": {
                                "description": "Error message",
                                "type": "string",
                                "example": "An error occurred"
                            },
                            "status": {
                                "description": "HTTP status code",
                                "type": "integer",
                                "example": 400
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "FeedHistoryResponse": {
                "title": "Feed History Response",
                "description": "Feed execution history response",
                "properties": {
                    "message": {
                        "description": "Response message",
                        "type": "string",
                        "example": "Histori feed berhasil dimuat."
                    },
                    "status": {
                        "description": "HTTP status code",
                        "type": "integer",
                        "example": 200
                    },
                    "data": {
                        "description": "Array of feed executions",
                        "type": "array",
                        "items": {
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "example": 1
                                },
                                "feed_schedule_id": {
                                    "type": "integer",
                                    "example": 1,
                                    "nullable": true
                                },
                                "scheduled_time": {
                                    "type": "string",
                                    "format": "time",
                                    "example": "08:00:00"
                                },
                                "executed_at": {
                                    "type": "string",
                                    "format": "date-time",
                                    "example": "2024-01-01 08:00:05"
                                },
                                "status": {
                                    "type": "string",
                                    "example": "completed"
                                },
                                "execution_type": {
                                    "type": "string",
                                    "example": "scheduled"
                                },
                                "delay_seconds": {
                                    "type": "integer",
                                    "example": 5,
                                    "nullable": true
                                },
                                "created_at": {
                                    "type": "string",
                                    "format": "date-time",
                                    "example": "2024-01-01 08:00:00"
                                }
                            },
                            "type": "object"
                        }
                    }
                },
                "type": "object"
            },
            "LoginRequest": {
                "title": "Login Request",
                "description": "Login request payload",
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "description": "User email address",
                        "type": "string",
                        "format": "email",
                        "example": "user@example.com"
                    },
                    "password": {
                        "description": "User password",
                        "type": "string",
                        "format": "password",
                        "example": "password123"
                    }
                },
                "type": "object"
            },
            "LoginResponse": {
                "title": "Login Response",
                "description": "Successful login response",
                "properties": {
                    "data": {
                        "properties": {
                            "message": {
                                "description": "Response message",
                                "type": "string",
                                "example": "Login berhasil!"
                            },
                            "status": {
                                "description": "HTTP status code",
                                "type": "integer",
                                "example": 200
                            },
                            "token": {
                                "description": "Sanctum authentication token",
                                "type": "string",
                                "example": "1|abcdefghijklmnopqrstuvwxyz123456"
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "LogoutResponse": {
                "title": "Logout Response",
                "description": "Successful logout response",
                "properties": {
                    "data": {
                        "properties": {
                            "message": {
                                "description": "Response message",
                                "type": "string",
                                "example": "Logout berhasil!"
                            },
                            "status": {
                                "description": "HTTP status code",
                                "type": "integer",
                                "example": 200
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "RegisterRequest": {
                "title": "Register Request",
                "description": "User registration request payload",
                "required": [
                    "fullname",
                    "email",
                    "no_telepon",
                    "password",
                    "password_confirm"
                ],
                "properties": {
                    "fullname": {
                        "description": "User full name (max 54 characters)",
                        "type": "string",
                        "maxLength": 54,
                        "example": "John Doe"
                    },
                    "email": {
                        "description": "User email address (must be unique)",
                        "type": "string",
                        "format": "email",
                        "example": "john.doe@example.com"
                    },
                    "no_telepon": {
                        "description": "User phone number (must be unique)",
                        "type": "string",
                        "example": "+6281234567890"
                    },
                    "password": {
                        "description": "User password",
                        "type": "string",
                        "format": "password",
                        "example": "SecurePassword123"
                    },
                    "password_confirm": {
                        "description": "Password confirmation (must match password)",
                        "type": "string",
                        "format": "password",
                        "example": "SecurePassword123"
                    }
                },
                "type": "object"
            },
            "RegisterResponse": {
                "title": "Register Response",
                "description": "Successful registration response",
                "properties": {
                    "data": {
                        "properties": {
                            "message": {
                                "description": "Response message",
                                "type": "string",
                                "example": "Register berhasil!"
                            },
                            "status": {
                                "description": "HTTP status code",
                                "type": "integer",
                                "example": 201
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "SensorHistoryResponse": {
                "title": "Sensor History Response",
                "description": "Sensor data history response with pagination",
                "properties": {
                    "message": {
                        "description": "Response message",
                        "type": "string",
                        "example": "Data history sensor berhasil dimuat."
                    },
                    "status": {
                        "description": "HTTP status code",
                        "type": "integer",
                        "example": 200
                    },
                    "data": {
                        "description": "Array of sensor readings",
                        "type": "array",
                        "items": {
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "example": 1
                                },
                                "kekeruhan": {
                                    "type": "number",
                                    "format": "float",
                                    "example": 45.5
                                },
                                "keasaman": {
                                    "type": "number",
                                    "format": "float",
                                    "example": 7.2
                                },
                                "suhu": {
                                    "type": "number",
                                    "format": "float",
                                    "example": 28.5
                                },
                                "waktu": {
                                    "type": "string",
                                    "format": "date-time",
                                    "example": "2024-01-01 12:00:00"
                                },
                                "data_source": {
                                    "type": "string",
                                    "example": "REAL_TIME"
                                },
                                "is_estimated": {
                                    "type": "boolean",
                                    "example": false
                                }
                            },
                            "type": "object"
                        }
                    },
                    "page": {
                        "properties": {
                            "order": {
                                "type": "string",
                                "example": "desc"
                            },
                            "limit": {
                                "type": "integer",
                                "example": 1000
                            },
                            "next_cursor": {
                                "type": "string",
                                "example": null,
                                "nullable": true
                            },
                            "has_more": {
                                "type": "boolean",
                                "example": false
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "UnauthorizedResponse": {
                "title": "Unauthorized Response",
                "description": "Unauthorized access response",
                "properties": {
                    "data": {
                        "properties": {
                            "message": {
                                "description": "Error message",
                                "type": "string",
                                "example": "Login Failed!"
                            },
                            "status": {
                                "description": "HTTP status code",
                                "type": "integer",
                                "example": 401
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "ValidationErrorResponse": {
                "title": "Validation Error Response",
                "description": "Validation error response structure",
                "properties": {
                    "message": {
                        "description": "Error message",
                        "type": "string",
                        "example": "Validasi gagal"
                    },
                    "status": {
                        "description": "HTTP status code",
                        "type": "integer",
                        "example": 422
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "description": "Laravel Sanctum authentication. Enter your token without the Bearer prefix.",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    },
    "tags": [
        {
            "name": "Authentication",
            "description": "User authentication and authorization endpoints"
        },
        {
            "name": "Feed",
            "description": "Feed control and history endpoints"
        },
        {
            "name": "Sensor",
            "description": "Sensor data monitoring and management endpoints"
        }
    ]
}